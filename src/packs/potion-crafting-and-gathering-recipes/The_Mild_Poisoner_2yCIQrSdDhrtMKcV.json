    {
      "name": "Liquid Paranoia",
      "type": "mastercrafted.mastercrafted",
      "text": {
        "content": "<p>A creature who ingests this poison is inflicted with the frightened condition, with the source of fear being the next humanoid it sees within 5 minutes of ingestion. The creature must make a DC 15 Wisdom saving throw, on a failed save the fear lasts for 1 hour or half as long on a success.</p>",
        "format": 1
      },
